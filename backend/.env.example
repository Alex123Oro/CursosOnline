NODE_ENV=development

# Supabase Auth
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA_DE_SUPABASE
# Requerida para el alta de instructores y el seed administrativo. Solo backend.
SUPABASE_SECRET_KEY=TU_CLAVE_SECRETA_DE_SUPABASE

# Conexiones PostgreSQL de Supabase
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DATOS?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DATOS?sslmode=require"

PUERTO=3000
CORS_ORIGIN=http://localhost:4200

# Origen público del frontend (HTTPS en producción), sin /verificar ni /api.
PUBLIC_APP_URL=http://localhost:4200
CERTIFICATE_VERIFICATION_LIMIT=30
CERTIFICATE_VERIFICATION_WINDOW_MS=60000

# Firma criptografica PDF. Archivo PKCS#12 y clave exclusivamente en backend.
# No versionar certificados privados ni contrasenas.
PDF_SIGNING_P12_PATH=
PDF_SIGNING_P12_PASSWORD=
# Las firmas de demostracion estan deshabilitadas.

NODE_ENV=development

# Supabase Auth
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA_DE_SUPABASE
# Requerida solo para crear usuarios desde el seed administrativo.
SUPABASE_SECRET_KEY=TU_CLAVE_SECRETA_DE_SUPABASE

# Conexiones PostgreSQL de Supabase
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DATOS?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DATOS?sslmode=require"

PUERTO=3000
CORS_ORIGIN=http://localhost:4200

# Cuentas de demostración para Supabase Auth. Reemplaza cada contraseña por
# una clave única de al menos 12 caracteres antes de ejecutar auth:seed-demo.
DEMO_ADMIN_EMAIL=admin@eva.local
DEMO_ADMIN_PASSWORD=REEMPLAZAR_ADMIN_CON_CLAVE_SEGURA
DEMO_INSTRUCTOR_EMAIL=carla.instructor@eva.local
DEMO_INSTRUCTOR_PASSWORD=REEMPLAZAR_INSTRUCTOR_CON_CLAVE_SEGURA
DEMO_PARTICIPANT_EMAIL=luis@eva.local
DEMO_PARTICIPANT_PASSWORD=REEMPLAZAR_PARTICIPANTE_CON_CLAVE_SEGURA
